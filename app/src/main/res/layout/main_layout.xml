<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <ScrollView
        android:id="@+id/watchHomeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/watchHomeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <ImageButton
                        android:id="@+id/diagnosticsToggle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_log"
                        android:contentDescription="@string/diagnostics_label" />
                    <ImageButton
                        android:id="@+id/diagnosticsExportButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_send_log"
                        android:contentDescription="@string/diagnostics_export_description" />
                    </LinearLayout>
            <LinearLayout
                android:id="@+id/watchHomeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:id="@+id/watchHomeHeading"
                    style="@style/CompanionHeading"
                    android:text="@string/companion_watch" />
                <TextView
                    android:id="@+id/watchHomeStatus"
                    style="@style/CompanionSubtitle"
                    android:text="@string/companion_disconnected" />
                <TextView
                    android:id="@+id/watchHomeTransport"
                    style="@style/CompanionSubtitle"
                    android:visibility="gone"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical" />
                <TextView
                    android:id="@+id/watchHomePurpose"
                    style="@style/CompanionSubtitle"
                    android:visibility="gone" />
            </LinearLayout>
            <Button
                android:id="@+id/watchHomeConnect"
                android:minHeight="48dp"
                style="@style/CompanionPrimaryAction"
                android:text="@string/companion_connect_watch" />
            <LinearLayout
                android:id="@+id/watchCapabilitiesPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <Button
                    android:id="@+id/openWatchSettingsButton"
                android:minHeight="48dp"
                    style="@style/CompanionPrimaryAction"
                    android:text="@string/companion_configure_watch" />
                <Button
                    android:id="@+id/watchDetailsButton"
                android:minHeight="48dp"
                    style="@style/CompanionAction"
                    android:text="@string/watch_details" />
                <Button
                    android:id="@+id/watchHomeDisconnect"
                android:minHeight="48dp"
                    style="@style/CompanionAction"
                    android:text="@string/companion_disconnect_watch"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- CONNECTION SCREEN -->
    <ScrollView
        android:id="@+id/deviceScreenScroll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:fillViewport="true">
    <LinearLayout
        android:id="@+id/deviceScreenRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/connectBackButton"
            style="@style/CompanionBackAction"
            android:text="@string/companion_back_to_watch" />

        <TextView
            android:id="@+id/connectHeading"
            style="@style/CompanionHeading"
            android:text="@string/companion_connect_watch" />

        <LinearLayout
            android:id="@+id/connectChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                style="@style/CompanionSectionHeading"
                android:text="@string/companion_purpose" />
            <RadioGroup
                android:id="@+id/connectionPurpose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/purposeBond"
                    style="@style/CompanionPurposeChoice"
                    android:text="@string/companion_purpose_bond_description" />
                <RadioButton
                    android:id="@+id/purposeConfigure"
                    style="@style/CompanionPurposeChoice"
                    android:text="@string/companion_purpose_configure_description" />
                <RadioButton
                    android:id="@+id/purposeGateway"
                    style="@style/CompanionPurposeChoice"
                    android:text="@string/companion_purpose_gateway_description" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/openGatewayButton"
            style="@style/CompanionPrimaryAction"
            android:text="@string/companion_open_gateway"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/connectionTransportRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/companion_connection_method"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/connectionModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:text="BLE"
                android:drawableEnd="@android:drawable/arrow_down_float" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/gatewayScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/gatewayPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/savedWatchReconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/savedWatchLabel"
                style="@style/CompanionSubtitle" />
            <Button
                android:id="@+id/reconnectWatchButton"
                style="@style/CompanionPrimaryAction"
                android:text="@string/companion_reconnect" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bleStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <TextView
            android:id="@+id/connection_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:gravity="center_vertical"
            android:text="NOT CONNECTED"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_chip_not_connected"
            android:textColor="@android:color/black"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="48dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:background="@drawable/btn_gray"
            android:textColor="@android:color/white"
            android:text="Scan" />
        <ImageButton
            android:id="@+id/bleSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_gray"
            android:src="@drawable/ic_watch_settings"
            android:padding="12dp"
            android:alpha="0.4"
            android:contentDescription="WearTAK watch settings"
            android:enabled="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pairingRecoveryPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/locationDiagnosticsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/systemBondedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/systemBondedWatchStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:gravity="center_vertical"
                    android:text="NOT CONNECTED"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_chip_not_connected"
                    android:textColor="@android:color/black"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/systemBondedConnectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_gray"
                    android:textColor="@android:color/white"
                    android:text="Connect" />
            <ImageButton
                android:id="@+id/systemBondedSettingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_gray"
                android:src="@drawable/ic_watch_settings"
                android:padding="12dp"
                android:alpha="0.4"
                android:contentDescription="WearTAK watch settings"
                android:enabled="false" />
            </LinearLayout>
            <TextView
                android:id="@+id/systemBondedIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/garminPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/garminConnectionBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:gravity="center_vertical"
                android:text="OFF"
                android:textColor="@android:color/white"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_chip_neutral"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/garminToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@drawable/btn_gray"
                android:textColor="@android:color/white"
                android:text="Retry" />
            <ImageButton
                android:id="@+id/garminSettingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_gray"
                android:src="@drawable/ic_watch_settings"
                android:padding="12dp"
                android:alpha="0.4"
                android:contentDescription="WearTAK watch settings"
                android:enabled="false" />
        </LinearLayout>

            <LinearLayout
                android:id="@+id/garminIdentityRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        <TextView
            android:id="@+id/garminConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Garmin Connect IQ is off."
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        </LinearLayout>


    </LinearLayout>
    </ScrollView>

    <!-- ================= SETTINGS SCREEN (SCROLLABLE) ================= -->
    <ScrollView
        android:id="@+id/settingsScreenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <!-- ScrollView MUST have exactly one child -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/settingsBackButton"
                style="@style/CompanionBackAction"
                android:text="@string/companion_back_to_watch" />

            <TextView
                android:id="@+id/settingsHeading"
                style="@style/CompanionHeading"
                android:text="@string/companion_configure_watch" />

            <LinearLayout
                android:id="@+id/configureWatchMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <Button
                    android:id="@+id/openWatchReadback"
                    style="@style/CompanionAction"
                    android:text="@string/companion_saved_settings" />
                <LinearLayout
                    android:id="@+id/configureTakMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        style="@style/CompanionSectionHeading"
                        android:text="@string/companion_tak_server" />
                    <TextView
                        android:id="@+id/configureWatchServer"
                        style="@style/CompanionSubtitle"
                        android:visibility="gone" />
                    <Button
                        android:id="@+id/importAtakServerButton"
                        style="@style/CompanionPrimaryAction"
                        android:text="@string/import_atak_title" />
                </LinearLayout>
                <Button
                    android:id="@+id/openCustomServerEditor"
                    style="@style/CompanionAction"
                    android:text="@string/companion_manual_setup" />
                <LinearLayout
                    android:id="@+id/configureVoiceMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <Button
                        android:id="@+id/voiceChannelsButton"
                        style="@style/CompanionAction"
                        android:text="@string/companion_voice_channels"
                        android:enabled="false" />
                    <TextView
                        android:id="@+id/voiceReadinessStatus"
                        style="@style/CompanionSubtitle"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/voiceTransferStatus"
                        style="@style/CompanionSubtitle"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/watchReadback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/CompanionSectionHeading"
                    android:text="@string/companion_tak_server" />
                <TextView
                    android:id="@+id/watchReadbackServers"
                    style="@style/CompanionSubtitle" />
                <TextView
                    style="@style/CompanionSectionHeading"
                    android:text="@string/watch_settings" />
                <TextView
                    android:id="@+id/watchReadbackIdentity"
                    style="@style/CompanionSubtitle" />
                <Button
                    android:id="@+id/refreshSettingsButton"
                    style="@style/CompanionPrimaryAction"
                    android:text="@string/companion_refresh_watch" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsStatus"
                style="@style/CompanionSubtitle"
                android:accessibilityLiveRegion="polite" />

            <LinearLayout android:id="@+id/customSettingsProfile"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
            <CheckBox
                android:id="@+id/phoneManagedSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Use WearTAK with this phone" />

            <TextView
                android:id="@+id/phoneManagedSettingsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use this phone's ATAK identity for the connected watch."
                android:paddingBottom="4dp" />

            <CheckBox
                android:id="@+id/copyPhoneIdentityOnce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/copy_atak_identity_once" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Callsign"
                    android:alpha="0.85" />

                <EditText
                    android:id="@+id/watchCallsign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="WEAROS-XYZ"
                    android:inputType="text"
                    android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/phoneTeam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:layout_marginStart="8dp"
                    android:text="Team (phone)\n—" />

                <TextView
                    android:id="@+id/phoneRole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Role (phone)\n—" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:text="Report interval"
                    android:alpha="0.85" />

                <EditText
                    android:id="@+id/reportInterval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="3"
                    android:inputType="number"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sec"
                    android:layout_marginStart="8dp"
                    android:alpha="0.85" />
            </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/serverSettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout android:id="@+id/customServerEditorGroup"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TAK Servers"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/takServerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="6dp">

                    <ImageButton
                        android:id="@+id/addServerButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Add Server"
                        android:src="@drawable/ic_plus_circle"
                        android:background="@android:color/transparent"
                        android:padding="8dp" />

                </LinearLayout>
                <!-- Selected Server -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected Server"
                    android:textStyle="bold"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <EditText
                    android:id="@+id/takName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Name" />

                <EditText
                    android:id="@+id/takAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Address (IP/DNS)" />

                <EditText
                    android:id="@+id/takPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Port"
                    android:inputType="number" />

                <CheckBox
                    android:id="@+id/takUseP12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Authenticate with P12 certificate"
                    android:paddingTop="6dp" />

                <EditText
                    android:id="@+id/takUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username (also retained with P12)"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/takPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password (also retained with P12)"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/takP12Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="No certificate selected."
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/takP12Password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="P12 password"
                    android:inputType="textPassword"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/takP12Buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/chooseP12Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Choose P12 File" />

                    <Button
                        android:id="@+id/clearP12Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Clear" />
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/sendSettingsButton"
                style="@style/CompanionPrimaryAction"
                android:text="@string/companion_send_to_watch"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
